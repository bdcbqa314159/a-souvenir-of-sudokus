  "version": "0.1.0",
  "identifier": "com.delapatada.souvenirsudokus",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8642",
    "beforeDevCommand": "trunk serve --port 8642",
    "beforeBuildCommand": "trunk build --release"
  },
  "app": {
    "windows": [
      {
        "title": "a-souvenir-of-sudokus",
        "width": 760,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 380,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
